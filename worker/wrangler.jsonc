{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pebble-note-sorter",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-29",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pebble-note-sorter",
			"database_id": "REPLACE_WITH_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	]
}
